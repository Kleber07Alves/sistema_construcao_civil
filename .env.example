# ─────────────────────────────────────────────────────────────────────────────
# Arquivo de exemplo para DESENVOLVIMENTO LOCAL (docker compose).
# Copie para .env:  cp .env.example .env
#
# Produção real NÃO usa este arquivo: as variáveis são definidas no Render
# (render.yaml — que gera JWT_SECRET seguro e define ENVIRONMENT=production)
# e no Vercel (NEXT_PUBLIC_API_URL).
# ─────────────────────────────────────────────────────────────────────────────

# ── Banco de dados ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/construcao_civil

# ── Autenticação JWT ─────────────────────────────────────────────────────────
# Chave APENAS para desenvolvimento local. Em produção, app/config.py recusa
# iniciar com chave insegura ou menor que 32 caracteres.
JWT_SECRET=chave_de_desenvolvimento_local_nao_usar_em_producao_0123456789
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Ambiente ─────────────────────────────────────────────────────────────────
# development | production | test
# Em "production" o config.py ativa validações de segurança que derrubam o
# servidor com configuração insegura — por isso o ambiente local é development.
ENVIRONMENT=development

# ── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Next.js (frontend) ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── SMTP — e-mails de alerta (opcional; sem SMTP o envio é simulado) ─────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alertas@empresa.com
SMTP_DESTINATARIO_PADRAO=gestor@empresa.com

# ── LLM API — resumo automático de currículos (opcional) ────────────────────
# Claude (preferencial)
ANTHROPIC_API_KEY=

# OpenAI (alternativa)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
