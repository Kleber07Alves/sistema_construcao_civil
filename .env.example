
# ── Banco de dados ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/construcao_civil

# ── Autenticação JWT ─────────────────────────────────────────────────────────

JWT_SECRET=troque_essa_chave_em_producao
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Ambiente ─────────────────────────────────────────────────────────────────

ENVIRONMENT=production

# ── CORS ─────────────────────────────────────────────────────────────────────

FRONTEND_URL=http://localhost:3000

# ── Next.js ──────────────────────────────────────────────────────────────────
backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── SMTP — e-mails de alerta (opcional) ─────────────────────────────────────

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alertas@empresa.com

# ── LLM API — resumo automático de currículos (opcional) ────────────────────

ANTHROPIC_API_KEY=

# OpenAI (alternativa)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
